# Copia este archivo como .env.local y arranca el servidor con npm run api.
# La URL base incluye el puerto, pero no el prefijo /api.
#
# Web en esta computadora o simulador iOS: http://localhost:3000
# Emulador Android: http://10.0.2.2:3000
# Celular físico en la misma Wi-Fi: http://IP_DE_TU_COMPUTADORA:3000
# Después de cambiar la URL, recarga por completo la app en Expo.

EXPO_PUBLIC_API_URL=http://localhost:3000
